# Copy to .env for docker compose / local overrides.
# Fresh MySQL loads apps/api/src/main/resources/db/schema.sql on first boot.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=today
MYSQL_USER=today
MYSQL_PASSWORD=today
MYSQL_PORT=3306

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

API_PORT=3001
WEB_PORT=3000

# Browser-facing API URL baked into the web image at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Change before any shared / production deployment.
TODAY_JWT_SECRET=today-dev-jwt-secret-change-me-please-32bytes

# mysql (default) | qdrant
TODAY_VECTOR_PROVIDER=mysql
TODAY_QDRANT_COLLECTION=today_memories
TODAY_VECTOR_ADMIN_TOKEN=
TODAY_AI_ADMIN_TOKEN=
TODAY_AI_ASYNC_CHECKIN=true

# Optional: enable real LLM + embeddings (otherwise HeuristicProvider).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
