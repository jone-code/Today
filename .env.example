# Copy to .env for docker compose / local overrides.
# Fresh MySQL loads apps/api/src/main/resources/db/schema.sql on first boot.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=today
MYSQL_USER=today
MYSQL_PASSWORD=today
MYSQL_PORT=3306

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- 国内镜像（DaoCloud；拉不动 Docker Hub 时用）----
# 若 daemon.json 里阿里云个人加速器 403，可改成：
#   "registry-mirrors": ["https://docker.m.daocloud.io"]
# 或直接用下面带前缀的镜像名（不依赖 registry-mirrors）。
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.18.3
JAVA_BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-17
JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-jammy
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim

API_PORT=3001
WEB_PORT=3000

# Browser API base (same-origin). Handled by apps/web/src/app/api/[...path]/route.ts
NEXT_PUBLIC_API_BASE_URL=/api
# Next.js server → API. Compose: http://today-api:3001 ；本地 dev: http://127.0.0.1:3001
API_PROXY_TARGET=http://today-api:3001

# Change before any shared / production deployment.
TODAY_JWT_SECRET=today-dev-jwt-secret-change-me-please-32bytes

# mysql (default) | qdrant
TODAY_VECTOR_PROVIDER=mysql
TODAY_QDRANT_COLLECTION=today_memories
TODAY_VECTOR_ADMIN_TOKEN=
TODAY_AI_ADMIN_TOKEN=
TODAY_AI_ASYNC_CHECKIN=true

# Optional: enable real LLM + embeddings (otherwise HeuristicProvider).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
