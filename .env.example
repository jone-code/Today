# Copy to .env for docker compose / local overrides.
# Fresh MySQL loads apps/api/src/main/resources/db/schema.sql on first boot.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=today
MYSQL_USER=today
MYSQL_PASSWORD=today
MYSQL_PORT=3306

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- 国内镜像（DaoCloud；拉不动 Docker Hub 时用）----
# 若 daemon.json 里阿里云个人加速器 403，可改成：
#   "registry-mirrors": ["https://docker.m.daocloud.io"]
# 或直接用下面带前缀的镜像名（不依赖 registry-mirrors）。
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.18.3
JAVA_BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-17
JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-jammy
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim

API_PORT=3001
WEB_PORT=3000

# Browser API base (same-origin). Handled by apps/web/src/app/api/[...path]/route.ts
NEXT_PUBLIC_API_BASE_URL=/api
# Next.js server → API. Compose: http://today-api:3001 ；本地 dev: http://127.0.0.1:3001
API_PROXY_TARGET=http://today-api:3001

# Change before any shared / production deployment.
TODAY_JWT_SECRET=today-dev-jwt-secret-change-me-please-32bytes

# mysql (default) | qdrant
TODAY_VECTOR_PROVIDER=mysql
TODAY_QDRANT_COLLECTION=today_memories
TODAY_VECTOR_ADMIN_TOKEN=
TODAY_AI_ADMIN_TOKEN=
TODAY_AI_ASYNC_CHECKIN=true

# Punch photo local storage (Docker bind-mount).
# Host directory → container /data/media (see docker-compose api.volumes).
TODAY_MEDIA_PATH=./data/media
# Path inside the API process / container (keep /data/media for Compose).
TODAY_MEDIA_ROOT=/data/media
# Max upload size in bytes (default 10 MiB).
TODAY_MEDIA_MAX_BYTES=10485760
# Voice transcription task limits per internal account.
TODAY_VOICE_PER_HOUR=20
TODAY_VOICE_PER_DAY=100

# Optional: enable real LLM + embeddings (otherwise HeuristicProvider).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Internal trial: empty allowlist denies registration, login and existing JWT access.
TODAY_INTERNAL_EMAIL_ALLOWLIST=
# Metrics remain inaccessible until a separate administrator token is configured.
TODAY_METRICS_ADMIN_TOKEN=
TODAY_METRICS_AUDIT_RETAIN_DAYS=180
# AES-256 export key: generate once with `openssl rand -base64 32`; retain while exports exist.
TODAY_DATA_EXPORT_KEY=
# Disable new requests for rollback; cleanup workers must keep running.
TODAY_DATA_EXPORT_ENABLED=true
TODAY_ACCOUNT_DELETE_ENABLED=true

# Configuration check only; use your actual HTTPS API origin.
TODAY_PUBLIC_API_URL=

# Post-deploy and internal-trial checks (read-only; keep report files private).
TODAY_OPS_API_URL=http://127.0.0.1:3001
TODAY_OPS_TIMEOUT_MS=10000
TODAY_OPS_FAIL_ON_WARNINGS=false
TODAY_TRIAL_API_URL=http://127.0.0.1:3001
TODAY_TRIAL_FROM=
TODAY_TRIAL_TO=
# Optional new output path; the report is created with mode 0600 and never overwritten.
TODAY_TRIAL_REPORT_OUT=
