<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.today.privacy.PrivacySettingsAuditMapper">
  <insert id="insert">INSERT INTO privacy_settings_audit
    (id,user_id,field,old_value,new_value,source,occurred_at)
    VALUES (#{id},#{userId},#{field},#{oldValue},#{newValue},#{source},#{occurredAt})</insert>
</mapper>
