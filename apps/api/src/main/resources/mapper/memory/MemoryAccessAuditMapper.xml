<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.today.memory.MemoryAccessAuditMapper">
  <insert id="insert">INSERT INTO memory_access_audit(id,user_id,memory_id,action,source,request_id,occurred_at,metadata_json) VALUES(#{id},#{userId},#{memoryId},#{action},#{source},#{requestId},#{occurredAt},#{metadataJson})</insert>
  <select id="list" resultType="com.today.memory.MemoryAccessAuditDto">SELECT id, memory_id, action, source, occurred_at FROM memory_access_audit WHERE user_id=#{userId} AND memory_id=#{memoryId} ORDER BY occurred_at DESC LIMIT #{limit}</select>
</mapper>
