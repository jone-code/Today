<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.today.review.WeeklyReviewMapper">
  <resultMap id="ReviewMap" type="com.today.persistence.WeeklyReviewEntity">
    <id property="id" column="id"/><result property="userId" column="user_id"/>
    <result property="weekStart" column="week_start"/><result property="status" column="status"/>
    <result property="attempts" column="attempts"/><result property="bodyJson" column="body_json"/>
    <result property="lastError" column="last_error"/><result property="lockedAt" column="locked_at"/>
    <result property="generatedAt" column="generated_at"/><result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <select id="find" resultMap="ReviewMap">
    SELECT id,user_id,week_start,status,attempts,body_json,last_error,locked_at,generated_at,created_at,updated_at
    FROM weekly_reviews WHERE user_id=#{userId} AND week_start=#{weekStart} LIMIT 1
  </select>
  <insert id="insert">
    INSERT INTO weekly_reviews (id,user_id,week_start,status,attempts,body_json,last_error,locked_at,generated_at,created_at,updated_at)
    VALUES (#{id},#{userId},#{weekStart},#{status},#{attempts},#{bodyJson},#{lastError},#{lockedAt},#{generatedAt},#{createdAt},#{updatedAt})
  </insert>
  <update id="update">
    UPDATE weekly_reviews SET status=#{status}, attempts=#{attempts}, body_json=#{bodyJson}, last_error=#{lastError},
      locked_at=#{lockedAt}, generated_at=#{generatedAt}, updated_at=#{updatedAt}
    WHERE id=#{id} AND user_id=#{userId}
  </update>
</mapper>
