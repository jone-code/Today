{
  "name": "today",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @today/web",
    "dev:web": "npm run dev -w @today/web",
    "dev:api": "cd apps/api && mvn spring-boot:run",
    "db:up": "docker compose up -d mysql",
    "vector:up": "docker compose up -d qdrant",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api web",
    "deploy:docker": "bash scripts/deploy-docker.sh up",
    "deploy:docker:down": "bash scripts/deploy-docker.sh down",
    "deploy:docker:status": "bash scripts/deploy-docker.sh status",
    "deploy:docker:logs": "bash scripts/deploy-docker.sh logs",
    "vector:reindex": "bash scripts/vector-reindex.sh",
    "db:down": "docker compose down",
    "test:api": "cd apps/api && mvn -q test",
    "ci:web": "npm run typecheck:contracts && npm run lint && npm run build",
    "build": "npm run build -w @today/web",
    "build:api": "cd apps/api && mvn -q package -DskipTests",
    "start": "npm run start -w @today/web",
    "lint": "npm run lint -w @today/web",
    "typecheck:contracts": "npm run typecheck -w @today/contracts",
    "db:init": "bash scripts/db-init.sh",
    "db:init:docker": "bash scripts/db-init.sh --docker",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:schema": "bash scripts/db-init.sh",
    "e2e:smoke": "bash scripts/e2e-smoke.sh",
    "e2e:smoke:api": "node scripts/e2e-smoke-api.mjs",
    "e2e:smoke:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
